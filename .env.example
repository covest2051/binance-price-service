# Binance
BINANCE_BASE_URL=https://api.binance.com
BINANCE_SYMBOLS=BNBUSDT
BINANCE_POLL_INTERVAL=PT30S
BINANCE_CONNECT_TIMEOUT=PT3S
BINANCE_READ_TIMEOUT=PT10S
BINANCE_DEFAULT_RETRY_AFTER=PT1M

# Trend
TREND_FLAT_THRESHOLD=0.002

# Database (DB_PORT is the host port of the compose database)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=binance_prices
DB_USERNAME=binance
DB_PASSWORD=binance
